APP_NAME=Dentrivo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:5173
PORT=8000

# ── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://meet68102_db_user:<db_password>@cluster0.32cyc6n.mongodb.net/dentrivo?retryWrites=true&w=majority


# ── Auth (replaces Laravel session guards) ───────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=120m
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ── Client origin for CORS ───────────────────────────────


# ── Files (replaces Laravel filesystems) ─────────────────
FILESYSTEM_DISK=local
STORAGE_PATH=./storage

# ── Mail / SMTP Configuration (Brevo / Sendinblue Production Relay) ──
# Driver: set to 'smtp' to send real emails via SMTP, or 'log' to log emails to console
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login-email@example.com
MAIL_PASSWORD=xsmtpsib-your-brevo-smtp-key
MAIL_FROM_ADDRESS=noreply@dentrivo.com
MAIL_FROM_NAME="Dentrivo Dental Clinic"

# ── Razorpay (PAY-01..PAY-05) ────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OTP Settings ─────────────────────────────────────────
OTP_EXPIRY_MINUTES=5


MESSAGE_API_SECRET_KEY=""